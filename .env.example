# 이 파일을 복사해서 .env로 저장하고 값을 채워요 (.env는 커밋 안 됨)
# 도커 DB(postgres 계정) 비밀번호. application-local.properties의 DB 비밀번호와 같게 하면 편해요
DB_PASSWORD=

# ── 아래는 서버까지 도커로 켤 때만 (docker compose --profile app, 11/16 ④) ──
# 값은 application-local.properties와 같아요. 비운 키는 그 기능만 대신 동작(추정·규칙)해요
# Gemini는 빈 값이면 서버가 안 켜질 수 있어서, 키가 없으면 앞에 #을 붙여 둬요
GEMINI_API_KEY=
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
ODSAY_API_KEY=
TOUR_API_KEY=
KMA_SERVICE_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
CODEF_SERVICE_TYPE=sandbox
CODEF_ORGANIZATION=
CODEF_CONNECTED_ID=
# 80번을 이미 다른 프로그램이 쓰면 바꿔요 (예: 8000 → http://localhost:8000)
WEB_PORT=80
